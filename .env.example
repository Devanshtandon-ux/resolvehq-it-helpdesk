# ResolveHQ SaaS Platform - Environment Configuration Template
# Duplicate this file to .env for local development

PORT=3000
NODE_ENV=development

# Database connection:
# Leave empty to use the built-in high-performance file-backed JSON persistent store (zero config),
# or provide a MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resolvehq?retryWrites=true&w=majority

# Session & Security Secret:
SESSION_SECRET=resolvehq-enterprise-session-secret-key-32chars

# Application URL:
APP_URL=http://localhost:3000

# Optional Gemini API Key:
GEMINI_API_KEY=MY_GEMINI_API_KEY
